{
    "scopeName": "source.aed",
    "patterns": [
        {
            "include": "#variables"
        },
        {
            "include": "#properties"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "variables": {
            "patterns": [
                {
                    "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:=|:|=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.readwrite.aed"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.aed"
                        }
                    }
                }
            ]
        },

        "properties": {
            "patterns": [
                {
                    "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.dot.aed"
                        },
                        "2": {
                            "name": "variable.other.property.aed"
                        }
                    }
                }
            ]
        },

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.aed",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.aed",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.aed",
                    "begin": "\"",
                    "end": "\""
                },
                {
                    "name": "string.quoted.single.aed",
                    "begin": "'",
                    "end": "'"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.aed",
                    "match": "(?i)\\b(ACCION|FIN_ACCION|AMBIENTE|PROCESO)\\b"
                },
                {
                    "name": "keyword.control.conditional.aed",
                    "match": "(?i)\\b(SI|ENTONCES|SINO|FIN_SI)\\b"
                },
                {
                    "name": "keyword.control.loop.aed",
                    "match": "(?i)\\b(PARA|HASTA|HACER|FIN_PARA|MIENTRAS|FIN_MIENTRAS|REPETIR|HASTA_QUE)\\b"
                },
                {
                    "name": "keyword.other.aed",
                    "match": "(?i)\\b(FUNCION|FIN_FUNCION|SUBACCION|FIN_SUBACCION|PROCEDIMIENTO|FIN_PROCEDIMIENTO)\\b"
                },
                {
                    "name": "support.function.aed",
                    "match": "(?i)(?:\\bABRIR\\b(?:/E/S|\\s+E/S|/E|\\s+E/|/S|\\s+S/)?|\\b(?:LEER|GRABAR|ESCRIBIR|ESC|RE-ESCRIBIR|REGRABAR|RE-GRABAR|BORRAR|CERRAR|ARR|ARRANCAR|AVZ|AVANZAR|CREAR|NUEVO|DISPONER|TRUNC|REDOND|ABSO|FDA|NFDA|FDS|NFDS|EXISTE)\\b)"
                }
            ]
        },

        "types": {
            "patterns": [
                {
                    "name": "storage.type.struct.aed",
                    "match": "(?i)\\b(ARREGLO|SECUENCIA|ARCHIVO|REGISTRO|FIN_REGISTRO|FR|PUNTERO|NODO)\\b"
                },
                {
                    "name": "storage.type.aed",
                    "match": "(?i)\\b(ENTERO|N|AN|REAL|ALFANUMERICO|NUMERICO|CARACTER|LOGICO|BOOLEANO|BOOLEANDO)\\b"
                },
                {
                    "name": "keyword.operator.aed",
                    "match": "(?i)\\b(DE|A|ORDENADO|INDEXADO|POR)\\b"
                }
            ]
        },

        "constants": {
            "patterns": [
                {
                    "name": "constant.language.aed",
                    "match": "(?i)\\b(VERDADERO|FALSO|V|F|NIL|HV|HIGH_VALUE|LV|LOW_VALUE|LECTURA|ESCRITURA|ACTUALIZACION)\\b"
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.aed",
                    "match": "(?i)\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.aed",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.arithmetic.aed",
                    "match": "\\b(MOD|DIV)\\b|[+\\-*/]"
                },
                {
                    "name": "keyword.operator.logical.aed",
                    "match": "(?i)\\b(EN|Y|O|NO)\\b"
                },
                {
                    "name": "keyword.operator.comparison.aed",
                    "match": "(<=|>=|<>|=|<|>)"
                },
                {
                    "name": "keyword.operator.range.aed",
                    "match": "\\.\\."
                }
            ]
        }
    }
}